# Werken-mapu — Variables de entorno
# Copiá este archivo a .env y completá los valores

# ─── Groq (LLM) ───────────────────────────────────────────────────
# API key de Groq Cloud. Sin esto, el asistente funciona offline.
# Obtenela en: https://console.groq.com/keys
GROQ_API_KEY=

# ─── WhatsApp Business Cloud API ──────────────────────────────────
# Token de acceso permanente desde Meta Business Suite
WHATSAPP_TOKEN=
# Phone Number ID del número de WhatsApp conectado
WHATSAPP_PHONE_NUMBER_ID=

# ─── Base de datos ────────────────────────────────────────────────
# Ruta del archivo SQLite local (solo desarrollo)
DB_PATH=wenuke.db

# ─── Turso (SQLite serverless — producción) ───────────────────────
# URL de la base de datos Turso (formato: libsql://...)
TURSO_DATABASE_URL=
# Token de autenticación de Turso
TURSO_AUTH_TOKEN=

# ─── Seguridad ────────────────────────────────────────────────────
# Token para el endpoint /enviar-alertas (admin).
# REQUERIDO en producción. Mínimo 16 caracteres.
# Generalo con: openssl rand -hex 32
ADMIN_TOKEN=

# ─── CORS ─────────────────────────────────────────────────────────
# Orígenes permitidos para CORS, separados por coma.
# En producción, solo el dominio de tu frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
