# Werken-mapu — Variables de entorno
# Copiar a .env: cp .env.example .env
# Todas son opcionales. El sistema funciona sin ninguna configurada.

# --- IA Conversacional ---
# API key de Groq (https://console.groq.com)
# Sin key → modo offline con reglas expertas pre-cargadas
GROQ_API_KEY=

# --- Base de datos ---
# Turso: BD SQLite serverless sobre HTTP (https://turso.tech)
# Sin configurar → usa SQLite local automáticamente
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Path del archivo SQLite local (default: wenuke.db)
# En Vercel se fuerza /tmp/wenuke.db por filesystem readonly
DB_PATH=

# --- WhatsApp Business API ---
# Token de acceso y Phone Number ID desde Meta Business
# Sin configurar → endpoints de WhatsApp retornan 501
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Seguridad ---
# Token para endpoints admin (/enviar-alertas, etc.)
# Mínimo 16 caracteres. Sin valor → endpoints admin retornan 501
ADMIN_TOKEN=

# --- Clima ---
# Días de pronóstico a consultar (default: 7, máximo: 16)
FORECAST_DAYS=7

# TTL del cache de clima en segundos (default: 3600 = 1 hora)
CACHE_TTL_SEGUNDOS=3600

# --- CORS ---
# Orígenes permitidos separados por coma (default: localhost + Vercel preview)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
