# ─── Werken-mapu — Variables de entorno ─────────────────────────────
# Copiar a .env y completar los valores marcados como REQUERIDOS.

# ─── Base de datos ─────────────────────────────────────────────────
# Opción A: SQLite local (desarrollo)
DB_PATH=wenuke.db

# Opción B: Turso (producción serverless) — REQUERIDO en Vercel
# TURSO_DATABASE_URL=libsql://tu-db.turso.io
# TURSO_AUTH_TOKEN=tu-token-turso

# ─── LLM (Groq) ───────────────────────────────────────────────────
# REQUERIDO para respuestas con IA. Sin esto, modo offline.
GROQ_API_KEY=

# ─── WhatsApp Business API (Meta) ──────────────────────────────────
# REQUERIDO para envío de alertas por WhatsApp.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ─── Seguridad ─────────────────────────────────────────────────────
# Token para endpoint admin POST /enviar-alertas. Mínimo 16 caracteres.
ADMIN_TOKEN=

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Entorno ───────────────────────────────────────────────────────
# VERCEL=1           # Lo setea Vercel automáticamente
# ENV=production     # Alternativa si no usás Vercel
# DEBUG=1            # Activar logging DEBUG
